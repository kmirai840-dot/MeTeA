# ローカルは .streamlit/secrets.toml、Cloudは管理画面のSecretsへ設定する。
# このひな形に実際の秘密情報を書かない。
METEA_AUTH_MODE = "google"
METEA_REQUIRE_AUTH = "true"
APP_ENV = "test"
OPENAI_API_KEY = ""
GOOGLE_MAPS_API_KEY = ""
# 個別ログインでは使用しない。legacyデモ専用。
APP_PASSWORD = ""
# 移行・検証完了後はpostgresqlに変更する。接続失敗時の自動切替はしない。
METEA_DATABASE_BACKEND = "sqlite"
# sqliteを選んだ場合のみ使用するファイルパス。
METEA_DATABASE_PATH = ""

[storage]
# 実際の接続文字列はGit管理対象外のsecretsにだけ保存する。
postgres_url = ""

[access]
# invite_codeならメール事前登録不要。Google側の公開設定も必要。
registration_mode = "email_allowlist"
# invite_code方式では16文字以上のランダムコードを設定する。
invite_code = ""
allowed_emails = ["tester@example.com"]
# 運営者もallowed_emailsへの登録が必要。空なら運営者画面は全員拒否。
admin_emails = []

[auth]
# Cloudでは https://metea-job-support.streamlit.app/oauth2callback に変更。
redirect_uri = "http://localhost:8501/oauth2callback"
# 32文字以上のランダム値を設定。下の仮値は置き換える。
cookie_secret = ""

[auth.google]
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
